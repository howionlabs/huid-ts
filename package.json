{
    "name": "@howionlabs/huid",
    "description": "The official reference implementation of Howion's Unique IDentifier in TypeScript.",
    "private": false,
    "author": {
        "name": "howion",
        "email": "me@howion.com",
        "url": "https://howion.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://git.howion.com/howionlabs/huid-ts.git"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@types/bun": "latest",
        "@types/node": "latest",
        "vitest": "^4.1.2",
        "markdownlint": "0.41.1"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "scripts": {
        "build": "bun run format && bun run test && rm -rf ./dist && bun build ./src/index.ts --outdir=./dist --target=node --format=esm --minify --sourcemap=linked && bunx dts-bundle-generator src/index.ts -o dist/index.d.ts",
        "prepack": "bun run build",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "test": "bunx vitest run",
        "test:watch": "bunx vitest"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "version": "1.0.1",
    "type": "module",
    "bugs": {
        "email": "me@howion.com",
        "url": "https://github.com/howionlabs/huid-ts/issues"
    },
    "dependencies": {},
    "license": "MIT"
}
